<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft Glow Behind Symbol -->
    <path
        android:pathData="M54,54m-28,0a28,28 0 1,0 56,0a28,28 0 1,0 -56,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="28"
                android:type="radial">
                <item android:color="#406366F1" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Squircle Glass Shield Frame -->
    <path
        android:pathData="M34,26 L74,26 A8,8 0 0 1 82,34 L82,74 A8,8 0 0 1 74,82 L34,82 A8,8 0 0 1 26,74 L26,34 A8,8 0 0 1 34,26 Z"
        android:fillColor="#141B2D"
        android:strokeWidth="1.75">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:type="linear">
                <item android:color="#818CF8" android:offset="0.0" />
                <item android:color="#06B6D4" android:offset="0.6" />
                <item android:color="#10B981" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Inward Dynamic Compression Chevron -->
    <path
        android:pathData="M39,41 L54,50 L69,41"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="39"
                android:startY="41"
                android:endX="69"
                android:endY="50"
                android:type="linear">
                <item android:color="#A5B4FC" android:offset="0.0" />
                <item android:color="#38BDF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom Inward Dynamic Compression Chevron -->
    <path
        android:pathData="M39,67 L54,58 L69,67"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="39"
                android:startY="67"
                android:endX="69"
                android:endY="58"
                android:type="linear">
                <item android:color="#38BDF8" android:offset="0.0" />
                <item android:color="#34D399" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central Focal Precision Core (Purity Diamond) -->
    <path
        android:pathData="M54,50 L58.5,54 L54,58 L49.5,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="49.5"
                android:startY="50"
                android:endX="58.5"
                android:endY="58"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#E0F2FE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Precision Indicator Dots -->
    <path
        android:pathData="M54,34 A1.75,1.75 0 1 1 53.9,34 Z"
        android:fillColor="#818CF8" />

    <path
        android:pathData="M54,74 A1.75,1.75 0 1 1 53.9,74 Z"
        android:fillColor="#34D399" />

</vector>